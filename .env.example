PORT=5000
NODE_ENV=development

MONGO_URI=your_mongodb_connection_string

CLIENT_URL=http://localhost:5173/

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
CSRF_SECRET=replace_with_a_second_long_random_secret

# Email: if omitted in development, messages are captured by Nodemailer's JSON transport.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AuthKit <no-reply@example.com>
# Local testing only. Never enable this in production.
DEV_EXPOSE_EMAIL_TOKENS=false

# Google OAuth (optional until OAuth routes are configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
